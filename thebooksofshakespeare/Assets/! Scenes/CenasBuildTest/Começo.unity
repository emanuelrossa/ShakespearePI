  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  type: 0
  id: Romeu
  npcName: Romeu
  dialogue:
  - "Shakespeare: Com licen\xE7a."
  - "Shakespeare: Voc\xEA conhece um garoto chamado Romeu?"
  - '???: Romeu Montecchio?'
  - 'Shakespeare: Isso mesmo.'
  - "Romeu: Ent\xE3o voc\xEA acabou de encontr\xE1-lo."
  - "Shakespeare: Ouvi dizer que voc\xEA est\xE1 com problemas."
  - 'Shakespeare: Talvez eu possa ajudar.'
  - 'Romeu: Preciso pular este muro. Acha que consegue me ajudar?'
  - 'Shakespeare: Vou tentar.'
  questDoneDialogue:
  - 'Romeu: Perfeito!'
  - 'Romeu: Muito obrigado.'
  - 'Romeu: Venha comigo.'
  - 'Romeu: Acho que ainda vou precisar da sua ajuda.'
