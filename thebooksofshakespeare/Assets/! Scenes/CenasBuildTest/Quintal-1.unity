  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  type: 0
  id: Romeu
  npcName: Romeu
  dialogue:
  - 'Romeu: Julieta.'
  - 'Julieta: Romeu...'
  - 'Romeu: Julieta!'
  - "Julieta: Se algu\xE9m te encontrar aqui, voc\xEA estar\xE1 em perigo."
  - "Romeu: N\xE3o me importo."
  - 'Shakespeare: (Agora eu me lembro...)'
  - 'Shakespeare: (Romeu e Julieta...)'
  - "Julieta: Meu amor por voc\xEA \xE9 maior que a rivalidade entre nossas fam\xEDlias."
  - "Romeu: E o meu por voc\xEA tamb\xE9m."
  - "(Um barulho vem da mans\xE3o)"
  - "Julieta: Algu\xE9m est\xE1 vindo!"
  - 'Julieta: Preciso entrar.'
  - 'Romeu: Eu voltarei.'
  - 'Romeu: Preciso enviar uma carta para a Julieta.'
  - 'Shakespeare: Acho que posso ajudar.'
  questDoneDialogue: []
  destroyWhen: 1
  targetToDestroy: {fileID: 382092863}
  changeSceneAfterQuestDone: 0
  sceneToLoad: 
  givesQuest: 1
  questType: 3
  target: Julieta
  requiredItem: Carta de Amor de Romeu
  isCompleted: 0
